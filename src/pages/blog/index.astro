---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { slugify } from "../../lib/slugify";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const base = import.meta.env.BASE_URL;
const topics = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Base title="Blog">
  <h1>Blog</h1>
  <p class="lede">I'm Shreyaan, an incoming Economic Sciences student at IISER Bhopal. I write to think through ideas as I learn them—from maths and economics to the choices and tools that shape a life.</p>

  {topics.length > 0 && (
    <nav class="blog-topics" aria-label="Browse writing by topic">
      <span>Browse by topic</span>
      {topics.map((topic) => <a class="tag tag--blog" href={`${base}blog/tags/${slugify(topic)}/`}>{topic}</a>)}
    </nav>
  )}

  {posts[0] && (
    <section class="blog-feature" aria-label="Latest post">
      <p class="section-kicker">Latest note</p>
      <a href={`${base}blog/${posts[0].id}/`}>{posts[0].data.title}<span aria-hidden="true"> ↗</span></a>
      <p>{posts[0].data.description}</p>
    </section>
  )}

  {posts.length === 0 ? (
    <p class="muted">No posts yet.</p>
  ) : (
    <ul class="entries">
      {posts.map((post) => (
        <li>
          {post.data.tags.length > 0 && (
            <div class="entry__meta entry__meta--blog">
              {post.data.tags.map((t) => <a href={`${base}blog/tags/${slugify(t)}/`} class="tag tag--blog">{t}</a>)}
            </div>
          )}
          <div class="entry__head">
            <a href={`${base}blog/${post.id}/`} class="entry__title">{post.data.title}</a>
            <span class="entry__date">
              {post.data.date.toLocaleDateString("en-IN", { year: "numeric", month: "short", day: "numeric" })}
            </span>
          </div>
          <p class="entry__desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
