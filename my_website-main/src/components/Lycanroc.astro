<script is:inline>
  (() => {
    try {
      const state = JSON.parse(sessionStorage.getItem("lycanroc-walk-state") || "null");
      if (state && Number.isFinite(state.x) && Number.isFinite(state.y)) {
        document.documentElement.style.setProperty("--lycanroc-left", `${state.x}px`);
        document.documentElement.style.setProperty("--lycanroc-top", `${state.y}px`);
      }
    } catch {}
  })();
</script>

<button class="lycanroc" type="button" data-lycanroc aria-label="Charizard companion. Tap for an introduction, drag to move, or use the arrow keys.">
  <img
    src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/showdown/6.gif"
    alt=""
    width="96"
    height="96"
    draggable="false"
  />
  <span class="lycanroc__hint" aria-hidden="true">tap for a quick intro · drag to move</span>
  <span class="lycanroc__intro" aria-hidden="true">I’m Shreyaan’s Pokémon companion! I keep an eye on this little corner of the internet while you explore his projects and writing.</span>
</button>

<script>
  const companion = document.querySelector("[data-lycanroc]");

  if (companion instanceof HTMLButtonElement) {
    const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
    const storageKey = "lycanroc-walk-state";
    let timer;
    let activeTarget = null;
    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let offsetX = 0;
    let offsetY = 0;

    const bounds = () => {
      const size = companion.offsetWidth;
      return { maxX: Math.max(8, window.innerWidth - size - 8), maxY: Math.max(8, window.innerHeight - size - 8) };
    };

    const moveTo = (x, y, durationOverride) => {
      const { maxX, maxY } = bounds();
      const nextX = Math.min(maxX, Math.max(8, x));
      const nextY = Math.min(maxY, Math.max(8, y));
      const box = companion.getBoundingClientRect();
      const currentX = box.left;
      const distance = Math.hypot(nextX - box.left, nextY - box.top);
      const travelDuration = durationOverride ?? Math.max(10, distance / 14);
      if (Math.abs(nextX - currentX) > 1) {
        companion.style.setProperty("--facing", nextX < currentX ? "-1" : "1");
      }
      activeTarget = { x: nextX, y: nextY };
      companion.style.setProperty("--travel-duration", `${travelDuration}s`);
      companion.style.left = `${nextX}px`;
      companion.style.top = `${nextY}px`;
      return travelDuration;
    };

    const randomSpot = () => {
      const { maxX, maxY } = bounds();
      return [8 + Math.random() * (maxX - 8), 8 + Math.random() * (maxY - 8)];
    };

    const roam = () => {
      if (dragging || motionPreference.matches) return;
      const box = companion.getBoundingClientRect();
      let [x, y] = randomSpot();
      for (let attempt = 0; attempt < 8 && Math.hypot(x - box.left, y - box.top) < 180; attempt++) {
        [x, y] = randomSpot();
      }
      const travelDuration = moveTo(x, y);
      timer = window.setTimeout(roam, (travelDuration + 2 + Math.random() * 3) * 1000);
    };

    const pauseRoam = () => window.clearTimeout(timer);
    const resumeRoam = () => {
      pauseRoam();
      if (!motionPreference.matches) timer = window.setTimeout(roam, 1500);
    };

    companion.addEventListener("pointerdown", (event) => {
      dragging = true;
      moved = false;
      pauseRoam();
      companion.dataset.dragging = "true";
      const box = companion.getBoundingClientRect();
      companion.style.left = `${box.left}px`;
      companion.style.top = `${box.top}px`;
      startX = event.clientX;
      startY = event.clientY;
      offsetX = event.clientX - box.left;
      offsetY = event.clientY - box.top;
      companion.setPointerCapture(event.pointerId);
    });

    companion.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      if (Math.abs(event.clientX - startX) + Math.abs(event.clientY - startY) > 5) moved = true;
      if (moved) moveTo(event.clientX - offsetX, event.clientY - offsetY);
    });

    companion.addEventListener("pointerup", () => {
      dragging = false;
      delete companion.dataset.dragging;
      if (moved) resumeRoam();
    });

    companion.addEventListener("click", () => {
      companion.dataset.open = companion.dataset.open === "true" ? "false" : "true";
      pauseRoam();
    });

    companion.addEventListener("pointercancel", () => {
      dragging = false;
      delete companion.dataset.dragging;
      resumeRoam();
    });

    companion.addEventListener("keydown", (event) => {
      const step = 24;
      const box = companion.getBoundingClientRect();
      const deltas = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
      if (deltas[event.key]) {
        event.preventDefault();
        moveTo(box.left + deltas[event.key][0], box.top + deltas[event.key][1]);
      }
    });

    window.addEventListener("resize", () => {
      const box = companion.getBoundingClientRect();
      moveTo(box.left, box.top);
    });

    motionPreference.addEventListener("change", () => {
      pauseRoam();
      if (!motionPreference.matches) resumeRoam();
    });

    const readSavedState = () => {
      try {
        const state = JSON.parse(sessionStorage.getItem(storageKey) || "null");
        if (state && Number.isFinite(state.x) && Number.isFinite(state.y)) return state;
      } catch {}
      return null;
    };

    window.addEventListener("pagehide", () => {
      const box = companion.getBoundingClientRect();
      try {
        sessionStorage.setItem(storageKey, JSON.stringify({
          x: box.left,
          y: box.top,
          facing: companion.style.getPropertyValue("--facing") || "1",
          target: activeTarget,
        }));
      } catch {}
    });

    const savedState = readSavedState();
    if (savedState) {
      companion.style.setProperty("--facing", savedState.facing || "1");
      if (savedState.target && !motionPreference.matches) {
        requestAnimationFrame(() => {
          const box = companion.getBoundingClientRect();
          const distance = Math.hypot(savedState.target.x - box.left, savedState.target.y - box.top);
          if (distance > 5) {
            const duration = Math.max(1, distance / 14);
            moveTo(savedState.target.x, savedState.target.y, duration);
            timer = window.setTimeout(roam, (duration + 2 + Math.random() * 3) * 1000);
          } else {
            activeTarget = savedState.target;
            resumeRoam();
          }
        });
      } else {
        activeTarget = savedState.target || null;
        resumeRoam();
      }
    } else {
      resumeRoam();
    }
  }
</script>

<style>
  .lycanroc {
    --facing: 1;
    position: fixed;
    left: var(--lycanroc-left, 1rem);
    top: var(--lycanroc-top, calc(100dvh - 6rem));
    z-index: 20;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: left var(--travel-duration, 18s) cubic-bezier(.4,0,.6,1), top var(--travel-duration, 18s) cubic-bezier(.4,0,.6,1);
    filter: drop-shadow(0 5px 8px rgb(0 0 0 / 18%));
  }

  .lycanroc img {
    display: block;
    width: 50px;
    height: 50px;
    object-fit: contain;
    image-rendering: pixelated;
    pointer-events: none;
    transform: scaleX(var(--facing));
    transition: transform .2s ease;
  }

  .lycanroc:hover img { animation: lycanroc-bob .5s ease-in-out infinite alternate; }
  .lycanroc:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 50%; }
  .lycanroc[data-dragging="true"] { cursor: grabbing; transition: none; }

  .lycanroc__hint {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 2px);
    padding: .2rem .45rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font: 10px/1.2 var(--font-sans);
    opacity: 0;
    transform: translateX(-50%) translateY(4px);
    transition: opacity .18s ease, transform .18s ease;
    pointer-events: none;
  }

  .lycanroc:hover .lycanroc__hint,
  .lycanroc:focus-visible .lycanroc__hint { opacity: 1; transform: translateX(-50%) translateY(0); }

  .lycanroc__intro {
    position: absolute;
    right: calc(100% + .7rem);
    bottom: 0;
    width: min(18rem, calc(100vw - 5rem));
    padding: .8rem .95rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 8px 28px rgb(0 0 0 / 14%);
    font: .78rem/1.5 var(--font-sans);
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s;
    pointer-events: none;
  }

  .lycanroc[data-open="true"] .lycanroc__intro {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @keyframes lycanroc-bob {
    from { transform: translateY(0); }
    to { transform: translateY(-4px); }
  }

  @media (max-width: 600px) {
    .lycanroc { width: 46px; height: 46px; }
    .lycanroc img { width: 42px; height: 42px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lycanroc { transition: none; }
    .lycanroc:hover img { animation: none; }
  }
</style>
