---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const projects = (await getCollection("projects"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="hero__identity">
      <img src={`${base}dp.jpg`} alt={SITE.author} class="hero__avatar" width="120" height="120" />
      <div>
        <p><strong>economics · mathematics · code</strong></p>
        <h1>Shreyaan Bhat</h1>
      </div>
    </div>

    <div class="hero__intro-row">
      <img src={`${base}pfp.jpeg`} alt={SITE.author} class="hero__portrait" width="120" height="120" />
      <p class="intro">
        I'm Shreyaan, an incoming Economic Sciences student at IISER Bhopal.
        I like working through hard ideas in maths and economics, then using
        code to make them concrete. This is where I share what I'm learning
        and the small things I'm building along the way.
      </p>
    </div>

    <div class="links">
      <a href={`${base}about`}>A little about me <span aria-hidden="true">↗</span></a>
      <a href={`mailto:${SITE.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
    </div>

    <nav class="home-socials" aria-label="Social links">
      <a href={SITE.github} target="_blank" rel="me noreferrer" aria-label="GitHub" title="GitHub">
        <img src="https://www.google.com/s2/favicons?domain=github.com&sz=64" alt="" width="20" height="20" />
      </a>
      <a href={SITE.linkedin} target="_blank" rel="me noreferrer" aria-label="LinkedIn" title="LinkedIn">
        <img src="https://www.google.com/s2/favicons?domain=linkedin.com&sz=64" alt="" width="20" height="20" />
      </a>
      <a href={SITE.X} target="_blank" rel="me noreferrer" aria-label="X" title="X">
        <img src="https://www.google.com/s2/favicons?domain=x.com&sz=64" alt="" width="20" height="20" />
      </a>
      <a href={SITE.instagram} target="_blank" rel="me noreferrer" aria-label="Instagram" title="Instagram">
        <img src="https://www.google.com/s2/favicons?domain=instagram.com&sz=64" alt="" width="20" height="20" />
      </a>
    </nav>
  </section>

  <section class="projects-preview">
    <div class="section-heading">
      <div><p class="section-kicker">A few things I've made</p><h2>Projects</h2></div>
      <a href={`${base}projects`}>All projects <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="home-list">
      {projects.map((project) => (
        <li>
          <a class="home-list__link" href={`${base}projects/${project.id}/`}>
            <span class="home-list__copy"><strong>{project.data.title}</strong><small>{project.data.description}</small></span>
            <span class="home-list__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="writing-preview">
    <div class="section-heading">
      <div><p class="section-kicker">Notes from along the way</p><h2>Writing</h2></div>
      <a href={`${base}blog`}>All writing <span aria-hidden="true">↗</span></a>
    </div>
    <ul class="home-list">
      {posts.map((post) => (
        <li>
          <a class="home-list__link" href={`${base}blog/${post.id}/`}>
            <span class="home-list__copy"><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
            <span class="home-list__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="about-preview">
    <div class="section-heading">
      <div><p class="section-kicker">What keeps me curious</p><h2>Economics, maths &amp; computation</h2></div>
    </div>
    <div class="interests">
      <span>economic theory</span><span>statistics</span><span>linear algebra</span>
      <span>programming</span><span>quantitative finance</span>
    </div>
  </section>
</Base>
